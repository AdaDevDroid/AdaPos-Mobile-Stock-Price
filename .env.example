USER_DB=your_sql_user
PASSWORD_DB=your_sql_password
SERVER_DB=your_sql_host
PORT_DB=1433
NAME_DB=default_database_name

NEXT_PUBLIC_BASE_PATH=/AdaCheckStockSTD
PORT=3001
APP_PORT=3001
NEXT_PUBLIC_VERSION=1.0.9
# Optional: CI/deployment commit SHA. If empty, each build generates a unique ID automatically.
NEXT_PUBLIC_BUILD_ID=
SESSION_SECRET=replace_with_long_random_secret
SETTINGS_ADMIN_USER=009
SETTINGS_ADMIN_PASSWORD=12345678

# Optional: comma-separated host allowlist for /api/call-promotion.
# Example: api.example.com,api.example.com:8443
PROMOTION_URL_ALLOWLIST=

# Optional: preferred TCNTUrlObject.FNUrlID for price/promotion lookup.
# If this ID is missing, the app falls back to an API2PSMaster URL.
PRICE_CHECK_URL_OBJECT_ID=5

# Optional: map the first URL path segment to a SQL Server connection.
# String values are still supported and use USER_DB/PASSWORD_DB/SERVER_DB/PORT_DB.
# Full values can override database, server, port, user, and password per part.
DATABASE_NAME_BY_PATH={"AdaCheckStockSTD":"AdaAccSTD_ByAgent","AdaCheckStockUAT":{"database":"AdaAccUAT_ByAgent","server":"your_uat_sql_host","port":1433,"user":"your_uat_sql_user","password":"your_uat_sql_password"}}
